<!doctype html>
<!--
  Emscripten shell for the osgVerse WebGPU demos.

  Unlike wasm/shell.html.in this one never calls canvas.getContext(): the canvas
  is owned by gles-on-webgpu, which creates a WebGPU context on it from C++
  (eglCreateWindowSurface with the "#canvas" selector). Asking for a WebGL
  context here would take the canvas over and make the WebGPU surface fail.
-->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>osgVerse on WebGPU</title>
  <style>
    :root { color-scheme: dark; }
    body {
      margin: 0; padding: 1.5rem; background: #10131a; color: #dfe4ee;
      font: 14px/1.5 ui-sans-serif, system-ui, sans-serif;
    }
    h1 { font-size: 1.1rem; margin: 0 0 .25rem; }
    p  { margin: 0 0 1rem; color: #9aa4b8; }
    canvas {
      display: block; width: @CANVAS_WIDTH@px; height: @CANVAS_HEIGHT@px;
      border: 1px solid #2b3242; border-radius: 4px; background: #000;
      touch-action: none;
    }
    pre {
      margin: 1rem 0 0; padding: .75rem; max-width: @CANVAS_WIDTH@px; max-height: 16rem;
      overflow: auto; background: #0a0c11; border: 1px solid #222836; border-radius: 4px;
      font: 12px/1.5 ui-monospace, monospace; white-space: pre-wrap;
    }
  </style>
</head>
<body>
  <h1>osgVerse / OpenSceneGraph &mdash; OpenGL ES 3 over WebGPU</h1>
  <p>Scene graph rendering executed by the browser's WebGPU through gles-on-webgpu.</p>

  <canvas id="canvas" width="@CANVAS_WIDTH@" height="@CANVAS_HEIGHT@" tabindex="-1"></canvas>
  <pre id="output"></pre>

  <script>
    var Module = {
      canvas: document.getElementById('canvas'),
      print: (function () {
        var output = document.getElementById('output');
        return function (text) { output.textContent += text + '\n'; };
      })(),
      printErr: (function () {
        var output = document.getElementById('output');
        return function (text) { output.textContent += 'error: ' + text + '\n'; };
      })()
    };

    (function () {
      var output = document.getElementById('output');
      function report(text) { output.textContent += 'error: ' + text + '\n'; }

      window.addEventListener('error', function (e) { report(e.message || String(e.error)); });
      window.addEventListener('unhandledrejection', function (e) { report(String(e.reason)); });

      if (!navigator.gpu) {
        report('this browser does not expose navigator.gpu (WebGPU).');
      } else {
        navigator.gpu.requestAdapter().then(function (adapter) {
          if (!adapter) {
            report('no WebGPU adapter is available (no GPU, or the browser is ' +
                   'blocking it). Chrome may need --enable-unsafe-webgpu.');
          }
        });
      }
    })();
  </script>
  {{{ SCRIPT }}}
</body>
</html>
