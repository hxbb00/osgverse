#ifndef _TVG_CONFIG_H_
#define _TVG_CONFIG_H_

// Generated by osgVerse CMake. Mirrors the subset of ThorVG's meson config that
// the vendored core is built with. Keep using "#cmakedefine" (not cmakedefine01)
// because ThorVG tests these with #ifdef.

#cmakedefine THORVG_THREAD_SUPPORT 1
#cmakedefine THORVG_OPENMP_SUPPORT 1
#cmakedefine THORVG_CPU_ENGINE_SUPPORT 1
#cmakedefine THORVG_PARTIAL_RENDER_SUPPORT 1
#cmakedefine THORVG_FILE_IO_SUPPORT 1
#cmakedefine THORVG_SFNT_LOADER_SUPPORT 1
#cmakedefine THORVG_TTF_LOADER_SUPPORT 1
#cmakedefine THORVG_OTF_LOADER_SUPPORT 1
#cmakedefine THORVG_SVG_LOADER_SUPPORT 1
#cmakedefine WIN32_LEAN_AND_MEAN 1

#define THORVG_VERSION_STRING "@THORVG_VERSION@"

#endif // _TVG_CONFIG_H_
